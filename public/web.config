<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- 1. Static Content MIME Types (WebP, SVG, WOFF2, JSON, XML) -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
    </staticContent>

    <!-- 2. HTTP Security Headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

    <!-- 3. URL Rewrite Engine -->
    <rewrite>
      <rules>
        <clear />

        <!-- Rule 1: Canonical Domain & HTTPS Force Redirect (Single 301 Hop) -->
        <rule name="Canonical Domain and HTTPS Redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^www\.modernfisheriese\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://modernfisheriese.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Rule 2: Decommissioned Legacy PDFs & Ebooks -> True Server HTTP 410 Gone -->
        <rule name="Decommissioned PDFs and Legacy Docs 410" stopProcessing="true">
          <match url="^(assets/docs/.*|assets/Docs/.*|.*\.pdf|ebooks?.*|downloads?.*|410(\.html)?)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="The requested PDF ebook or document has been permanently decommissioned." />
        </rule>

        <!-- Rule 3: 301 Permanent Redirects for Legacy URL Aliases to Canonical SEO Paths -->
        <rule name="301 Redirect: Home" stopProcessing="true">
          <match url="^home/?$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Aquaponics" stopProcessing="true">
          <match url="^aquaponics/?$" ignoreCase="true" />
          <action type="Redirect" url="/aquaponics-farming" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Biofloc" stopProcessing="true">
          <match url="^biofloc(-farming)?/?$" ignoreCase="true" />
          <action type="Redirect" url="/bioflock" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: RAS" stopProcessing="true">
          <match url="^(ras|ras-farming|recirculating)/?$" ignoreCase="true" />
          <action type="Redirect" url="/aquaponic" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Hydroponics" stopProcessing="true">
          <match url="^(hydroponics|soilless)/?$" ignoreCase="true" />
          <action type="Redirect" url="/hydroponic" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Pond" stopProcessing="true">
          <match url="^pond/?$" ignoreCase="true" />
          <action type="Redirect" url="/pond-farming" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Diseases" stopProcessing="true">
          <match url="^diseases/?$" ignoreCase="true" />
          <action type="Redirect" url="/fish-diseases" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Feed" stopProcessing="true">
          <match url="^feed/?$" ignoreCase="true" />
          <action type="Redirect" url="/feeding-management" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Calculators" stopProcessing="true">
          <match url="^(calculator|calc)/?$" ignoreCase="true" />
          <action type="Redirect" url="/calculators" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Services and Shopping" stopProcessing="true">
          <match url="^(services|shopping|shop)/?$" ignoreCase="true" />
          <action type="Redirect" url="/ourservices" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: About Us" stopProcessing="true">
          <match url="^about/?$" ignoreCase="true" />
          <action type="Redirect" url="/about-us" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Video Root" stopProcessing="true">
          <match url="^video/?$" ignoreCase="true" />
          <action type="Redirect" url="/farming-videos" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Videos" stopProcessing="true">
          <match url="^videos/?$" ignoreCase="true" />
          <action type="Redirect" url="/farming-videos" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: FAQ" stopProcessing="true">
          <match url="^faq/?$" ignoreCase="true" />
          <action type="Redirect" url="/frequently-asked-questions" redirectType="Permanent" />
        </rule>
        <rule name="301 Redirect: Privacy" stopProcessing="true">
          <match url="^privacy/?$" ignoreCase="true" />
          <action type="Redirect" url="/privacy-policy" redirectType="Permanent" />
        </rule>

        <!-- Rule 4: Serve pre-rendered static HTML for clean extensionless routes (supports multi-level paths like /video/slug-id and /calculators) -->
        <!-- Placed BEFORE trailing slash removal so IIS serves pre-rendered HTML directly without Directory Handler trailing slash loops -->
        <rule name="Serve Clean Route HTML" stopProcessing="true">
          <match url="^([a-zA-Z0-9\-_\/]+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{DOCUMENT_ROOT}/{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/{R:1}.html" />
        </rule>

        <!-- Rule 5: Remove Trailing Slash (Consolidate canonical URLs without trailing slashes, e.g. /calculators/ -> /calculators) -->
        <rule name="Remove Trailing Slash" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_METHOD}" pattern="GET" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Redirect" url="https://modernfisheriese.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Rule 6: React Single Page Application (SPA) HTML5 History Routing -->
        <rule name="React SPA Client Routing" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- 4. HTTP Error Handling & Status PassThrough (Preserves 410 Gone) -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <!-- 5. Security: Prevent Directory Browsing -->
    <directoryBrowse enabled="false" />

  </system.webServer>

  <!-- 6. Temporary Compilation Directory -->
  <system.web>
    <compilation tempDirectory="D:\INETPUB\VHOSTS\owncircles.com\tmp" />
  </system.web>
</configuration>