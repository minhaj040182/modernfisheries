# Prevent directory listing
Options -Indexes

# Disable Apache's automatic trailing-slash redirection for physical directories so mod_rewrite maintains clean canonical URLs
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS and non-www canonical host (Single 301 Redirect)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.modernfisheriese\.com$ [NC]
  RewriteRule ^(.*)$ https://modernfisheriese.com/$1 [L,R=301]

  # 3. Return HTTP 410 Gone for permanently removed PDF documents & assets/Docs
  RewriteRule ^assets/(docs|Docs)/ - [G,NC,L]
  RewriteRule \.(pdf)$ - [G,NC,L]

  # 4. Permanent 301 Redirects for legacy and alias paths
  RewriteRule ^home/?$ / [R=301,L]
  RewriteRule ^video/?$ /farming-videos [R=301,L]
  RewriteRule ^videos/?$ /farming-videos [R=301,L]
  RewriteRule ^ras/?$ /aquaponic [R=301,L]
  RewriteRule ^ras-farming/?$ /aquaponic [R=301,L]
  RewriteRule ^shopping/?$ /ourservices [R=301,L]
  RewriteRule ^shop/?$ /ourservices [R=301,L]
  RewriteRule ^aquaponics/?$ /aquaponics-farming [R=301,L]
  RewriteRule ^biofloc/?$ /bioflock [R=301,L]
  RewriteRule ^biofloc-farming/?$ /bioflock [R=301,L]
  RewriteRule ^hydroponics/?$ /hydroponic [R=301,L]
  RewriteRule ^pond/?$ /pond-farming [R=301,L]
  RewriteRule ^diseases/?$ /fish-diseases [R=301,L]
  RewriteRule ^feed/?$ /feeding-management [R=301,L]
  RewriteRule ^calculator/?$ /calculators [R=301,L]
  RewriteRule ^calc/?$ /calculators [R=301,L]
  RewriteRule ^services/?$ /ourservices [R=301,L]
  RewriteRule ^about/?$ /about-us [R=301,L]
  RewriteRule ^faq/?$ /frequently-asked-questions [R=301,L]
  RewriteRule ^privacy/?$ /privacy-policy [R=301,L]

  # 5. Internal rewrite to serve pre-rendered static HTML for clean extensionless routes
  # Placed BEFORE trailing slash removal so Apache directly serves the HTML without mod_dir loops
  # Supports multi-level paths like /video/slug-id -> video/slug-id.html and /calculators -> calculators.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-zA-Z0-9\-_/]+)$ $1.html [L]

  # 6. Enforce No Trailing Slash on subpages (e.g. /calculators/ -> /calculators or /video/slug-id/ -> /video/slug-id)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteRule ^(.+)/$ https://modernfisheriese.com/$1 [L,R=301]

  # 7. Fallback to index.html for client-side routing
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.html [L]
</IfModule>

# Custom error documents
ErrorDocument 410 /410.html
ErrorDocument 404 /404.html

